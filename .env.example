# MediCycle Environment Configuration Template
# Copy this file to .env or configure in Apache/PHP environment

APP_ENV=development
APP_DEBUG=true

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicycle_db
DB_USER=root
DB_PASS=

# Base URL (Leave empty for dynamic auto-detection)
APP_URL=http://localhost/medicycle

# SMTP Email Configuration (For Real 6-Digit Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@medicycle.org
SMTP_FROM_NAME="MediCycle Platform"
